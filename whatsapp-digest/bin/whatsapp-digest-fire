#!/bin/bash
set -euo pipefail

export HOME=/Users/pattybot

NODE=/opt/homebrew/bin/node
APP_DIR="$HOME/.local/share/whatsapp-digest"
LOG="$HOME/Library/Logs/whatsapp-digest.log"
LOCK_DIR="$HOME/.claude/skills/whatsapp-digest/state/fire.lock"

mkdir -p "$(dirname "$LOG")" "$HOME/.claude/skills/whatsapp-digest/state"

{
  echo "===== fire $(date -u +%Y-%m-%dT%H:%M:%SZ) args=$* ====="

  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "whatsapp-digest: another fire is already running"
    exit 3
  fi
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

  cd "$APP_DIR"
  "$NODE" "$APP_DIR/src/digest-cli.js" "$@"
} >>"$LOG" 2>&1
