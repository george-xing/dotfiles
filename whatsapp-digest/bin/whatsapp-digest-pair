#!/bin/bash
set -euo pipefail

export HOME=/Users/pattybot

if [[ $# -gt 0 ]]; then
  export WHATSAPP_DIGEST_PHONE_NUMBER="$1"
fi

if [[ -z "${WHATSAPP_DIGEST_PHONE_NUMBER:-}" ]]; then
  echo "usage: whatsapp-digest-pair <phone-number-with-country-code>" >&2
  echo "example: whatsapp-digest-pair +12125550100" >&2
  exit 64
fi

export WHATSAPP_DIGEST_HEADLESS=false
export WHATSAPP_DIGEST_OPEN_QR=false
export WHATSAPP_DIGEST_READY_TIMEOUT_MS="${WHATSAPP_DIGEST_READY_TIMEOUT_MS:-600000}"
export WHATSAPP_DIGEST_EXIT_AFTER_READY_MS="${WHATSAPP_DIGEST_EXIT_AFTER_READY_MS:-60000}"

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
if [[ -x "$CHROME" && -z "${WHATSAPP_DIGEST_CHROME_PATH:-}" ]]; then
  export WHATSAPP_DIGEST_CHROME_PATH="$CHROME"
fi

exec /Users/pattybot/bin/whatsapp-digest-mcp
