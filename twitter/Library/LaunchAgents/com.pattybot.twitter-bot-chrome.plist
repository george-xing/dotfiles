<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pattybot.twitter-bot-chrome</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
        <string>--user-data-dir=/Users/pattybot/Library/Application Support/twitter-bot-chrome</string>
        <string>--remote-debugging-port=9222</string>
        <string>--no-first-run</string>
        <string>--no-default-browser-check</string>
    </array>

    <!--
        KeepAlive implies an initial speculative launch (per launchd.plist(5)),
        so RunAtLoad would be redundant. launchd already throttles fast-exit
        respawns to ~once per 10s by default — no ThrottleInterval needed.
        ExitTimeOut gives Chrome 30s to flush profile state on bootout before
        SIGKILL — important so cookie/session SQLite writes don't get truncated.
    -->
    <key>KeepAlive</key>
    <true/>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/pattybot/Library/Logs/twitter-bot-chrome.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/pattybot/Library/Logs/twitter-bot-chrome.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/pattybot</string>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
