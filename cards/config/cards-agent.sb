;; macOS Seatbelt profile for the post-login browser agent only.
;; Authentication runs before this process and is intentionally outside it.
(version 1)

;; Preserve normal Codex/CDP/network behavior, then remove every known route
;; to the cards service-account token or 1Password material.
(allow default)

;; The service-account token is stored in Login Keychain with an ACL that
;; trusts only cards-keychain. Deny Keychain IPC as a second boundary.
(deny mach-lookup
  (global-name "com.apple.securityd")
  (global-name "com.apple.securityd.xpc"))

;; Do not let the agent execute credential brokers or general automation
;; tools that could ask another GUI process to retrieve a secret.
(deny process-exec
  (literal "/Users/pattybot/.local/bin/cards-keychain")
  (literal "/Users/pattybot/.local/bin/op")
  (literal "/Users/pattybot/bin/cards-auth.py")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-auth.py")
  (literal "/bin/launchctl")
  (literal "/usr/bin/open")
  (literal "/usr/bin/security")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/crontab")
  (literal "/usr/bin/at"))

;; Prevent copying or interpreting the denied executables/scripts and prevent
;; reading secret references, 1Password state, or Keychain database files.
(deny file-read-data
  (literal "/Users/pattybot/.local/bin/cards-keychain")
  (literal "/Users/pattybot/.local/bin/op")
  (literal "/Users/pattybot/bin/cards-auth.py")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-auth.py")
  (subpath "/Users/pattybot/.config/cards")
  (subpath "/Users/pattybot/.config/op")
  (subpath "/Users/pattybot/Library/Keychains")
  (subpath "/Users/pattybot/Library/Application Support/1Password"))

;; The agent never needs to mutate any credential store either.
(deny file-write*
  (literal "/Users/pattybot/dotfiles/cards/config/cards-agent.sb")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-fire.sh")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-auth.py")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-offers.py")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-keychain.swift")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-keychain-migrate.sh")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-onepassword-provision.sh")
  (literal "/Users/pattybot/dotfiles/cards/bin/cards-onepassword-setup.sh")
  (literal "/Users/pattybot/dotfiles/cards/.claude/skills/credit-card-offers/SKILL.md")
  (literal "/Users/pattybot/dotfiles/cards/Library/LaunchAgents/com.pattybot.credit-card-offers.plist")
  (subpath "/Users/pattybot/Library/LaunchAgents")
  (subpath "/Users/pattybot/.ssh")
  (literal "/Users/pattybot/.zshrc")
  (literal "/Users/pattybot/.zprofile")
  (literal "/Users/pattybot/.bash_profile")
  (literal "/Users/pattybot/.bashrc")
  (subpath "/Users/pattybot/.config/cards")
  (subpath "/Users/pattybot/.config/op")
  (subpath "/Users/pattybot/Library/Keychains")
  (subpath "/Users/pattybot/Library/Application Support/1Password"))
